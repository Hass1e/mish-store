# Секретный ключ для JWT
JwtSettings__SecretKey=mish-store-super-secret-key-2026-at-least-32-chars-long!

# Время жизни токена (в минутах)
JwtSettings__AccessTokenExpirationMinutes=4320

# Настройки куки
AuthCookie__ExpirationMinutes=4320

# URL API (для продакшена здесь будет адрес твоего сервера или домена)
ApiSettings__BaseUrl=http://localhost:5073